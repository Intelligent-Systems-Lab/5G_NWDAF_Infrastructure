.vagrant/
.cache/
.venv/
__pycache__/
*.py[cod]

# Complete config sets generated or maintained locally.
config/local/*
!config/local/.gitkeep

# User-authored experiment definitions.
experiments/local/*
!experiments/local/.gitkeep

# Build and runtime state stay inside guests.
build/
dist/
runtime/
.generated/
runs/
*.log
*.pid
