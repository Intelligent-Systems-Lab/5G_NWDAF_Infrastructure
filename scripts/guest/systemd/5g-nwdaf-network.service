[Unit]
Description=5G NWDAF persistent topology address reconciliation
After=systemd-networkd.service network-online.target
Wants=network-online.target
Before=5g-nwdaf-stack.target
ConditionPathExists=/etc/5g-nwdaf-infrastructure/active/network

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/5g-nwdaf-infrastructure/network-setup
RemainAfterExit=yes
